#!/bin/sh -eu

# The default Buildtest directory should sit within the $SNAP_USER_DATA because:
# - access to the system's /var/lib/buildtest/default isn't guaranteed, and
# - the default $BUILDTEST path should also be removed when removing the snap.
DEFAULT_BUILDTEST_DIRECTORY="${SNAP_USER_DATA}"
export BUILDTEST="${BUILDTEST:-$DEFAULT_BUILDTEST_DIRECTORY}"

exec "${SNAP}/bin/buildtest" "$@"
