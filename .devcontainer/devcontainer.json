// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/universal
{
	"name": "Ubuntu 26.04",
	"runArgs": [
		//"-v", "/foo/bar:/workspace/bar"
	],

  "updateRemoteUserUID": false,
  "containerUser": "ubuntu",

	"containerEnv": {
		"EDITOR": "code"
	},
	"mounts": [
    "source=${localEnv:HOME}/upstream/tako-workspace/tako-a,target=/tako-a,type=bind",
    "source=${localEnv:HOME}/upstream/tako-workspace/tako-b,target=/tako-b,type=bind",
    "source=${localEnv:HOME}/upstream/tako-workspace/tako-c,target=/tako-c,type=bind",
    "source=${localEnv:HOME}/upstream/tako-workspace/tako-d,target=/tako-d,type=bind",
    "source=${localEnv:HOME}/upstream/tako-workspace/tako-e,target=/tako-e,type=bind",
  ]

	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	}
}
